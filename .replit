modules = ["web", "bash", "postgresql-16", "nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
APP_URL = "https://67ed4534-e0c8-4009-bbff-81aa1e8b991d-00-2546t1ds68wv4.replit.dev"

[userenv.production]
APP_URL = "https://pokerclubs.abhayjhade.com"
